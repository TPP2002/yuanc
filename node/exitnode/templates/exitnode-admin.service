[Unit]
Description=出口节点管理服务（待接入）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Environment=PYTHONPATH=$program_path
Type=simple
ExecStart=/usr/bin/python3 -m exitnode --placeholder admin --config "$config_path"
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
