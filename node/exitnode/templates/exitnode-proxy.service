[Unit]
Description=出口节点隧道服务
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=$binary run -c /var/lib/exitnode/secrets/sing-box.json
ExecReload=/bin/kill -HUP $$MAINPID
Restart=always
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
