[Unit]
Description=出口节点客户端包托管服务
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Environment=PYTHONPATH=/opt/exitnode/current
Type=simple
ExecStart=/usr/bin/python3 -m exitnode --config "/etc/exitnode/config.toml" admin serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
