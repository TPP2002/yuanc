<UserControl x:Class="WinClient.App.Views.MainShell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:WinClient.App.Views" xmlns:p="clr-namespace:WinClient.App.Presentation" xmlns:t="clr-namespace:WinClient.App.Themes"
 Background="{DynamicResource Yc.Bg}" FontFamily="{DynamicResource Yc.Font.Cn}" FontSize="{DynamicResource Yc.FontSize.Base}" Foreground="{DynamicResource Yc.Text}"
 KeyboardNavigation.TabNavigation="Continue">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/WinClient.App;component/Themes/Base.xaml"/>
   <ResourceDictionary Source="/WinClient.App;component/Themes/Glyphs.xaml"/>
   <ResourceDictionary Source="/WinClient.App;component/Themes/Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="Connect"><views:ConnectPage/></DataTemplate>
  <DataTemplate x:Key="Routing"><views:RoutingPage/></DataTemplate>
  <DataTemplate x:Key="Environment"><views:EnvironmentPage/></DataTemplate>
  <DataTemplate x:Key="Account"><views:AccountPage/></DataTemplate>
  <DataTemplate x:Key="Update"><views:UpdatePage/></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Yc.Surface}" BorderBrush="{DynamicResource Yc.Line}" BorderThickness="0,0,1,0" Padding="8,12">
   <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Yc.Line}" BorderThickness="1" CornerRadius="{DynamicResource Yc.Radius.Md}" Padding="12,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Ellipse Width="8" Height="8"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Yc.N}"/><Style.Triggers>
       <DataTrigger Binding="{Binding ServiceStateTone}" Value="{x:Static p:Tone.Ok}"><Setter Property="Fill" Value="{DynamicResource Yc.Ok}"/></DataTrigger>
       <DataTrigger Binding="{Binding ServiceStateTone}" Value="{x:Static p:Tone.Warn}"><Setter Property="Fill" Value="{DynamicResource Yc.Warn}"/></DataTrigger>
       <DataTrigger Binding="{Binding ServiceStateTone}" Value="{x:Static p:Tone.Bad}"><Setter Property="Fill" Value="{DynamicResource Yc.Bad}"/></DataTrigger>
      </Style.Triggers></Style></Ellipse.Style></Ellipse>
      <TextBlock Grid.Column="1" Text="{Binding ServiceStateText}" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" Margin="8,0,0,0" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceVersionText}" FontSize="{DynamicResource Yc.FontSize.Xs}" FontFamily="{DynamicResource Yc.Font.Mono}" Foreground="{DynamicResource Yc.Text3}" Margin="8,2,0,0" Visibility="{Binding ServiceVersionText, Converter={x:Static t:VisibilityConverter.Instance}}"/>
     </Grid>
    </Border>
    <StackPanel KeyboardNavigation.TabNavigation="Continue">
     <RadioButton Style="{DynamicResource Yc.Navigation}" GroupName="Pages" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={x:Static t:PageChoiceConverter.Instance}, ConverterParameter={x:Static p:PageKind.Connect}}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{DynamicResource Yc.Icon.Plug}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="连接" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{DynamicResource Yc.Navigation}" GroupName="Pages" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={x:Static t:PageChoiceConverter.Instance}, ConverterParameter={x:Static p:PageKind.Routing}}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{DynamicResource Yc.Icon.Layers}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="代理范围" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{DynamicResource Yc.Navigation}" GroupName="Pages" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={x:Static t:PageChoiceConverter.Instance}, ConverterParameter={x:Static p:PageKind.Environment}}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{DynamicResource Yc.Icon.Sun}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="环境一致" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{DynamicResource Yc.Navigation}" GroupName="Pages" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={x:Static t:PageChoiceConverter.Instance}, ConverterParameter={x:Static p:PageKind.Account}}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{DynamicResource Yc.Icon.Key}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="账号与配对" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{DynamicResource Yc.Navigation}" GroupName="Pages" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={x:Static t:PageChoiceConverter.Instance}, ConverterParameter={x:Static p:PageKind.Update}}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{DynamicResource Yc.Icon.Download}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="更新与诊断" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel>
  </Border>
  <ContentControl x:Name="PageHost" Grid.Column="1" Margin="32,24" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{DynamicResource Connect}"/><Style.Triggers>
    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static p:PageKind.Routing}"><Setter Property="ContentTemplate" Value="{DynamicResource Routing}"/></DataTrigger>
    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static p:PageKind.Environment}"><Setter Property="ContentTemplate" Value="{DynamicResource Environment}"/></DataTrigger>
    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static p:PageKind.Account}"><Setter Property="ContentTemplate" Value="{DynamicResource Account}"/></DataTrigger>
    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static p:PageKind.Update}"><Setter Property="ContentTemplate" Value="{DynamicResource Update}"/></DataTrigger>
   </Style.Triggers></Style></ContentControl.Style>
  </ContentControl>
 </Grid>
</UserControl>
