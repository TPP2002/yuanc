<UserControl x:Class="WinClient.App.Views.UpdatePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:WinClient.App.Controls" xmlns:t="clr-namespace:WinClient.App.Themes" xmlns:v="clr-namespace:WinClient.App.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
  <TextBlock Text="更新与诊断" Style="{DynamicResource Yc.Title}" Margin="0,0,0,16"/>
  <Border Style="{DynamicResource Yc.Card}"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="后台服务" Foreground="{DynamicResource Yc.Text2}" FontSize="{DynamicResource Yc.FontSize.Sm}"/>
    <TextBlock Grid.Column="1" Text="{Binding ServiceVersionDisplay}" FontFamily="{DynamicResource Yc.Font.Mono}" FontSize="{DynamicResource Yc.FontSize.Sm}"/>
    <TextBlock Grid.Row="1" Text="界面程序" Foreground="{DynamicResource Yc.Text2}" FontSize="{DynamicResource Yc.FontSize.Sm}" Margin="0,8,0,0"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVersion}" FontFamily="{DynamicResource Yc.Font.Mono}" FontSize="{DynamicResource Yc.FontSize.Sm}" Margin="0,8,0,0"/>
    <TextBlock Grid.Row="2" Text="上次检查" Foreground="{DynamicResource Yc.Text2}" FontSize="{DynamicResource Yc.FontSize.Sm}" Margin="0,8,0,0"/>
    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdateCheckedAtText}" FontSize="{DynamicResource Yc.FontSize.Sm}" Margin="0,8,0,0"/>
   </Grid>
   <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" FontSize="{DynamicResource Yc.FontSize.Sm}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   <TextBlock Text="{Binding ConnectionDisabledReason}" Style="{DynamicResource Yc.Hint}" Visibility="{Binding ConnectionDisabledReason, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  </StackPanel></Border>
  <TextBlock Text="诊断" FontWeight="Bold" Margin="0,24,0,8"/>
  <TextBlock Text="把防火墙审计和环境自检报告合成一个文件(不含出口 IP),发给管理员排查。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap"/>
  <Button Content="导出诊断…" Command="{x:Static v:MainShell.ExportDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  <TextBlock Text="正在处理,请稍候再导出诊断。" Style="{DynamicResource Yc.Hint}" Visibility="{Binding IsBusy, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  <TextBlock Text="{Binding DiagnosticsMessage}" Style="{DynamicResource Yc.Hint}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding DiagnosticsMessage, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  <Border Style="{DynamicResource Yc.StatusRow}" Margin="0,24,0,0" Visibility="{Binding IsUpdateIndicatorVisible, Converter={x:Static t:VisibilityConverter.Instance}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <c:StatusTile Tone="Info" Glyph="Dots" Flow="Forward" VerticalAlignment="Center"/><TextBlock Grid.Column="1" t:MonoText.Text="{Binding UpdateMessage}" TextWrapping="Wrap" Margin="12,0,0,0"/>
  </Grid></Border>
 </StackPanel></ScrollViewer>
</UserControl>
