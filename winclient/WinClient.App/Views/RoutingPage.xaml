<UserControl x:Class="WinClient.App.Views.RoutingPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:WinClient.App.Controls" xmlns:t="clr-namespace:WinClient.App.Themes">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
  <TextBlock Text="代理范围" Style="{DynamicResource Yc.Title}" Margin="0,0,0,16"/>
  <StackPanel IsEnabled="{Binding CanChangeRouting}"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".6"/></Trigger></Style.Triggers></Style></StackPanel.Style>
   <RadioButton Style="{DynamicResource Yc.ChoiceCard}" GroupName="Routing" IsChecked="{Binding RoutingIsGlobal, Mode=TwoWay}"><StackPanel>
    <TextBlock Text="全部流量(推荐)" FontWeight="Bold"/><TextBlock Text="所有程序都从澳洲出口上网;隧道断了就整机断网,不漏流量;局域网设备(打印机、路由器页)照常可用。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap"/>
   </StackPanel></RadioButton>
   <RadioButton Style="{DynamicResource Yc.ChoiceCard}" GroupName="Routing" Margin="0,8,0,0" IsChecked="{Binding RoutingIsApps, Mode=TwoWay}"><StackPanel>
    <TextBlock Text="仅指定程序" FontWeight="Bold"/><TextBlock Text="只有下面列出的程序走澳洲出口,其他程序直连、不受断网保护。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap"/>
   </StackPanel></RadioButton>
   <TextBlock Text="指定的程序" FontWeight="Bold" Margin="0,24,0,8"/>
   <TextBlock Text="按完整路径匹配;程序升级后路径变了要重新添加。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <ItemsControl ItemsSource="{Binding RoutingApps}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{DynamicResource Yc.StatusRow}" Padding="12,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <c:StatusTile Tone="Info" Glyph="Check" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding}" ToolTip="{Binding}" FontFamily="{DynamicResource Yc.Font.Mono}" FontSize="{DynamicResource Yc.FontSize.Sm}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/>
     <Button Grid.Column="2" Content="移除" Style="{DynamicResource Yc.Button.QuietSmall}" Click="Remove_Click"/>
    </Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Grid Visibility="{Binding RoutingApps.Count, Converter={x:Static t:VisibilityConverter.Instance}, ConverterParameter=Invert}">
    <Rectangle Stroke="{DynamicResource Yc.LineStrong}" StrokeDashArray="3 3" RadiusX="6" RadiusY="6"/>
    <TextBlock Text="还没有指定程序;点「添加程序…」选一个 .exe" Margin="16" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text3}" TextWrapping="Wrap"/>
   </Grid>
   <Button Content="添加程序…" Command="{Binding AddRoutingAppCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel>
  <TextBlock Style="{DynamicResource Yc.Hint}" Foreground="{DynamicResource Yc.Warn}" Text="连接中不能改代理范围,请先在「连接」页断开。" Visibility="{Binding CanChangeRouting, Converter={x:Static t:VisibilityConverter.Instance}, ConverterParameter=Invert}"/>
  <TextBlock Style="{DynamicResource Yc.Hint}" Text="{Binding ConnectionDisabledReason}" Visibility="{Binding ConnectionDisabledReason, Converter={x:Static t:VisibilityConverter.Instance}}"/>
 </StackPanel></ScrollViewer>
</UserControl>
