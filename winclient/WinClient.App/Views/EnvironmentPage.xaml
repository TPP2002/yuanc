<UserControl x:Class="WinClient.App.Views.EnvironmentPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:WinClient.App.Controls" xmlns:t="clr-namespace:WinClient.App.Themes">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="环境一致" Style="{DynamicResource Yc.Title}"/>
   <Border Margin="12,0,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Yc.Badge}"><Style.Triggers><DataTrigger Binding="{Binding EnvironmentEnabled}" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.OkBg}"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <TextBlock Text="{Binding EnvironmentBadgeText}" FontSize="{DynamicResource Yc.FontSize.Xs}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Yc.N}"/><Style.Triggers><DataTrigger Binding="{Binding EnvironmentEnabled}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Yc.Ok}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Border>
  </StackPanel>
  <Border Style="{DynamicResource Yc.Card}"><StackPanel>
   <ToggleButton Style="{DynamicResource Yc.Switch}" IsChecked="{Binding EnvironmentEnabled, Mode=TwoWay}" IsEnabled="{Binding CanUseConnection}" AutomationProperties.Name="连接时切换到澳洲时区与浏览器语言"><StackPanel>
    <TextBlock Text="连接时切换到澳洲时区与浏览器语言" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock Text="开着:连上后把系统时区设为澳洲东部、关闭自动时区,给 Chrome 与 Edge 设首选语言;断开按原值恢复。只覆盖 Chrome 与 Edge。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel></ToggleButton>
   <TextBlock Text="后台服务未就绪,暂时不能改" Style="{DynamicResource Yc.Hint}" Visibility="{Binding CanUseConnection, Converter={x:Static t:VisibilityConverter.Instance}, ConverterParameter=Invert}"/>
  </StackPanel></Border>
  <StackPanel Orientation="Horizontal" Margin="0,24,0,8"><TextBlock Text="环境自检" FontWeight="Bold"/>
   <Border Margin="12,0,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Yc.Badge}"><Style.Triggers>
    <DataTrigger Binding="{Binding SelfCheckTone}" Value="Ok"><Setter Property="Background" Value="{DynamicResource Yc.OkBg}"/></DataTrigger>
    <DataTrigger Binding="{Binding SelfCheckTone}" Value="Warn"><Setter Property="Background" Value="{DynamicResource Yc.WarnBg}"/></DataTrigger>
    <DataTrigger Binding="{Binding SelfCheckTone}" Value="Bad"><Setter Property="Background" Value="{DynamicResource Yc.BadBg}"/></DataTrigger>
    <DataTrigger Binding="{Binding SelfCheckTone}" Value="Info"><Setter Property="Background" Value="{DynamicResource Yc.InfoBg}"/></DataTrigger>
   </Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SelfCheckStatus}" FontSize="{DynamicResource Yc.FontSize.Xs}" t:SemanticText.Tone="{Binding SelfCheckTone}"/></Border>
  </StackPanel>
  <TextBlock Text="每次核验完出口后自动检查一遍;只报告,不修复。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" Margin="0,0,0,8" TextWrapping="Wrap"/>
  <ItemsControl ItemsSource="{Binding SelfCheckItems}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{DynamicResource Yc.StatusRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <c:StatusTile Spec="{Binding Tile}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Index}" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap" Visibility="{Binding Detail, Converter={x:Static t:VisibilityConverter.Instance}}"/></StackPanel>
    <TextBlock Grid.Column="3" Text="{Binding Result}" t:SemanticText.Tone="{Binding Tile.Tone}" FontSize="{DynamicResource Yc.FontSize.Sm}" VerticalAlignment="Center"/>
   </Grid></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="连上一次后才有自检明细" Style="{DynamicResource Yc.Hint}" Visibility="{Binding SelfCheckItems.Count, Converter={x:Static t:VisibilityConverter.Instance}, ConverterParameter=Invert}"/>
 </StackPanel></ScrollViewer>
</UserControl>
