<UserControl x:Class="WinClient.App.Views.AccountPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:t="clr-namespace:WinClient.App.Themes">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="账号与配对" Style="{DynamicResource Yc.Title}"/>
   <Border Style="{DynamicResource Yc.ModeBadge}" Margin="12,0,0,0"><TextBlock Text="{Binding ModeText}" Style="{DynamicResource Yc.ModeBadgeText}"/></Border>
  </StackPanel>
  <Border Style="{DynamicResource Yc.Card}"><StackPanel>
   <TextBlock Text="自用:导入配对文件" FontWeight="Bold"/>
   <TextBlock Text="用小主机导出的 .ycpair 文件,不联系任何服务器。更换前请先断开连接。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <Button Content="导入配对文件" Command="{Binding ImportPairingCommand}" Style="{DynamicResource Yc.Button.Primary}" HorizontalAlignment="Left"/>
   <TextBlock Text="{Binding PairingDisabledReason}" Style="{DynamicResource Yc.Hint}" Visibility="{Binding PairingDisabledReason, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  </StackPanel></Border>
  <Border Style="{DynamicResource Yc.Card}" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="分发版:输入邀请码" FontWeight="Bold"/>
   <TextBlock Text="管理员发的邀请码,兑换后由鉴权服务器下发线路;兑换成功再点「连接」。" FontSize="{DynamicResource Yc.FontSize.Sm}" Foreground="{DynamicResource Yc.Text2}" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <Label Content="邀请码" Target="{Binding ElementName=InviteCode}" Padding="0,0,0,4" Foreground="{DynamicResource Yc.Text2}" FontSize="{DynamicResource Yc.FontSize.Sm}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="InviteCode" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Yc.Font.Mono}" AutomationProperties.Name="邀请码" IsEnabled="{Binding CanUseConnection}"/>
    <Button Grid.Column="1" Content="兑换邀请码" Command="{Binding RedeemCommand}" Margin="8,0,0,0"/>
   </Grid>
   <TextBlock Text="{Binding ConnectionDisabledReason}" Style="{DynamicResource Yc.Hint}" Visibility="{Binding ConnectionDisabledReason, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  </StackPanel></Border>
  <Button Content="清除本机配对文件" Command="{Binding ClearPairingCommand}" Style="{DynamicResource Yc.Button.Quiet}" Foreground="{DynamicResource Yc.Bad}" HorizontalAlignment="Right" Margin="0,24,0,0"/>
  <TextBlock Text="{Binding ClearPairingDisabledReason}" Style="{DynamicResource Yc.Hint}" Visibility="{Binding ClearPairingDisabledReason, Converter={x:Static t:VisibilityConverter.Instance}}"/>
  <TextBlock Text="清除后要重新导入才能连接;连接中不能清除。" Style="{DynamicResource Yc.Hint}"/>
 </StackPanel></ScrollViewer>
</UserControl>
