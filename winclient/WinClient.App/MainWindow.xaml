<Window x:Class="WinClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="澳洲出口客户端" Width="480" Height="750" MinWidth="430" MinHeight="730"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="澳洲出口客户端" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,22"/>
    <StackPanel Grid.Row="1">
      <TextBlock Text="{Binding Mode}" Margin="0,0,0,10"/>
      <Button Content="导入配对文件" Command="{Binding ImportPairingCommand}" Height="38" Margin="0,0,0,16"
              ToolTip="选择小主机导出的配对文件；更换前请先断开连接。"/>
      <Label Content="邀请码" Target="{Binding ElementName=InviteCode}" Padding="0,0,0,6"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="兑换" Command="{Binding RedeemCommand}" Width="80" Margin="10,0,0,0"/>
        <TextBox x:Name="InviteCode" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8"/>
      </DockPanel>
    </StackPanel>
    <Button Grid.Row="2" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Height="68" FontSize="23" Margin="0,24,0,18"/>
    <StackPanel Grid.Row="3">
      <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding ExitLine}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#536174"/>
      <TextBlock Text="{Binding GuardLine}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#8A2E2E" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding SelfCheckLine}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#536174" AutomationProperties.LiveSetting="Polite"/>
      <CheckBox Content="连接时切换到澳洲时区与浏览器语言(环境一致性)" IsChecked="{Binding EnvironmentEnabled, Mode=TwoWay}" IsEnabled="{Binding CanUseConnection}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding EnvironmentLine}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#536174"/>
      <TextBlock Text="{Binding ServiceVersion}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" HorizontalAlignment="Center" Padding="16,6" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="4" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Grid.Row="5" Text="部分程序自带防火墙放行规则，断线时可能仍可直连。" TextWrapping="Wrap" Foreground="#6B4B20" VerticalAlignment="Bottom" Margin="0,16"/>
    <StackPanel Grid.Row="6">
      <Button Content="清除配对文件" Command="{Binding ClearPairingCommand}" HorizontalAlignment="Right" Padding="8,4" Margin="0,0,0,8"
              ToolTip="删除本机保存的配对资料；请先断开连接。"/>
      <Button Content="导出诊断" Click="Export_Click" Height="36" ToolTip="导出防火墙审计与环境自检报告"/>
    </StackPanel>
  </Grid>
</Window>
