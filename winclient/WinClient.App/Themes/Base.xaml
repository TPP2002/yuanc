  <FontFamily x:Key="Yc.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="Yc.FontSize.Xs">12</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Sm">14</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Base">16</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Md">18</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Lg">20</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Xl">24</sys:Double>
  <sys:Double x:Key="Yc.FontSize.Xxl">28</sys:Double>
  <CornerRadius x:Key="Yc.Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Yc.Radius.Md">6</CornerRadius>
