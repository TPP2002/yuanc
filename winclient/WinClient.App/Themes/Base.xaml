  <sys:Double x:Key="Yc.Space.6">32</sys:Double>
  <sys:Double x:Key="Yc.Space.7">48</sys:Double>
  <Duration x:Key="Yc.Dur.Press">0:0:.12</Duration>
  <Duration x:Key="Yc.Dur.Small">0:0:.18</Duration>
  <Duration x:Key="Yc.Dur.Panel">0:0:.24</Duration>
  <Duration x:Key="Yc.Dur.Draw">0:0:.6</Duration>
  <Duration x:Key="Yc.Dur.Number">0:0:.3</Duration>
  <Duration x:Key="Yc.Dur.Flow">0:0:3.4</Duration>
  <Duration x:Key="Yc.Dur.FlowFast">0:0:2.4</Duration>
