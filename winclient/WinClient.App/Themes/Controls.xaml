<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WinClient.App.Themes">
  <Style x:Key="Yc.FocusVisualStyle">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Rectangle Margin="-4" Stroke="{DynamicResource Yc.Focus}" StrokeThickness="2" RadiusX="2" RadiusY="2"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Yc.Font.Cn}"/>
    <Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Base}"/>
    <Setter Property="Foreground" Value="{DynamicResource Yc.Text}"/>
  </Style>
  <Style x:Key="Yc.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Xl}"/><Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="Yc.Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Sm}"/><Setter Property="Foreground" Value="{DynamicResource Yc.Text3}"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,16,0,0"/>
  </Style>
  <Style x:Key="Yc.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Yc.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Yc.Line}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource Yc.Radius.Lg}"/>
    <Setter Property="Padding" Value="16"/><Setter Property="Effect" Value="{DynamicResource Yc.Shadow}"/>
  </Style>
  <Style x:Key="Yc.StatusRow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Yc.Surface2}"/><Setter Property="BorderBrush" Value="{DynamicResource Yc.Line}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource Yc.Radius.Md}"/>
    <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="Yc.Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Yc.NBg}"/><Setter Property="CornerRadius" Value="{DynamicResource Yc.Radius.Sm}"/>
    <Setter Property="Padding" Value="8,2"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Yc.FontSize.Xs}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Yc.N}"/>
  </Style>
  <Style x:Key="Yc.ModeBadge" TargetType="Border" BasedOn="{StaticResource Yc.Badge}">
    <Style.Triggers><DataTrigger Binding="{Binding ModeText}" Value="分发模式"><Setter Property="Background" Value="{DynamicResource Yc.InfoBg}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Yc.ModeBadgeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Xs}"/><Setter Property="Foreground" Value="{DynamicResource Yc.N}"/>
    <Style.Triggers><DataTrigger Binding="{Binding ModeText}" Value="分发模式"><Setter Property="Foreground" Value="{DynamicResource Yc.Info}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Yc.Button.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Yc.Font.Cn}"/><Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Base}"/>
    <Setter Property="Background" Value="{DynamicResource Yc.Surface2}"/><Setter Property="Foreground" Value="{DynamicResource Yc.Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Yc.CtrlBorder}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="16,8"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Yc.FocusVisualStyle}"/>
    <Setter Property="local:ControlMotion.Kind" Value="Button"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Yc.Radius.Md}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
          <ContentPresenter.ContentTemplate><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
              FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
              FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </DataTemplate></ContentPresenter.ContentTemplate>
        </ContentPresenter>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.Surface3}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.Surface3}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
      <Trigger Property="local:ControlMotion.IsBusy" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Foreground" Value="{DynamicResource Yc.Text2}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Yc.Button.Secondary}"/>
  <Style x:Key="Yc.Button.Primary" TargetType="Button" BasedOn="{StaticResource Yc.Button.Secondary}">
    <Setter Property="Background" Value="{DynamicResource Yc.Action}"/><Setter Property="Foreground" Value="{DynamicResource Yc.ActionText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Yc.Action}"/><Setter Property="FontWeight" Value="Bold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.ActionHover}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.ActionPress}"/></Trigger>
      <Trigger Property="local:ControlMotion.IsBusy" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.ActionHover}"/><Setter Property="Foreground" Value="{DynamicResource Yc.ActionText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Yc.Button.Quiet" TargetType="Button" BasedOn="{StaticResource Yc.Button.Secondary}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Yc.Text2}"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.Surface2}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Yc.Button.Small" TargetType="Button" BasedOn="{StaticResource Yc.Button.Secondary}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,4"/><Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Sm}"/>
  </Style>
  <Style x:Key="Yc.Button.QuietSmall" TargetType="Button" BasedOn="{StaticResource Yc.Button.Quiet}">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,4"/><Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Sm}"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Yc.Font.Cn}"/><Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Base}"/>
    <Setter Property="Foreground" Value="{DynamicResource Yc.Text}"/><Setter Property="Background" Value="{DynamicResource Yc.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Yc.CtrlBorder}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Yc.FocusVisualStyle}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Yc.Radius.Md}">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Yc.Focus}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Yc.ChoiceCard" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Yc.FocusVisualStyle}"/>
    <Setter Property="Foreground" Value="{DynamicResource Yc.Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Card" BorderBrush="{DynamicResource Yc.Line}" BorderThickness="1" Background="{DynamicResource Yc.Surface}" CornerRadius="{DynamicResource Yc.Radius.Lg}" Padding="16,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,3,0,0">
            <Ellipse x:Name="Circle" Stroke="{DynamicResource Yc.CtrlBorder}" StrokeThickness="2"/>
            <Ellipse x:Name="Selected" Fill="{DynamicResource Yc.Info}" Margin="5" Visibility="Collapsed"/>
          </Grid>
          <ContentPresenter Grid.Column="1" Margin="12,0,0,0"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Yc.InfoBg}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Yc.Info}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Padding" Value="15,11"/><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Yc.Info}"/><Setter TargetName="Selected" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Yc.Navigation" TargetType="RadioButton">
    <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="FontSize" Value="{DynamicResource Yc.FontSize.Base}"/><Setter Property="FontFamily" Value="{DynamicResource Yc.Font.Cn}"/>
    <Setter Property="Foreground" Value="{DynamicResource Yc.Text2}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Yc.FocusVisualStyle}"/><Setter Property="local:ControlMotion.Kind" Value="Navigation"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Yc.Radius.Md}" Padding="12,0">
        <ContentPresenter VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.Surface2}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Yc.Surface3}"/><Setter Property="BorderBrush" Value="{DynamicResource Yc.Line}"/><Setter Property="Foreground" Value="{DynamicResource Yc.Text}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Yc.Switch" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Yc.FocusVisualStyle}"/><Setter Property="local:ControlMotion.Kind" Value="Switch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderBrush="{DynamicResource Yc.CtrlBorder}" BorderThickness="1" Background="{DynamicResource Yc.Surface3}" VerticalAlignment="Center">
          <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Yc.Text3}"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
        </Border>
        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="{DynamicResource Yc.InfoBg}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Yc.Info}"/>
        <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Yc.Info}"/>
      </Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 自绘细滚动条:不随系统视觉主题变化(服务账户的非交互会话不加载主题,系统滚动条会换成经典样式)。 -->
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border x:Name="Bar" Margin="2" CornerRadius="{DynamicResource Yc.Radius.Sm}" Background="{DynamicResource Yc.LineStrong}"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource Yc.Text3}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
